{
  "id": "slack-subagent-card",
  "name": "Slack Subagent Card",
  "version": "1.2.13",
  "description": "Posts and updates a Slack Block Kit status card for sub-agent work in Slack threads.",
  "activation": {
    "onStartup": true,
    "onChannels": [
      "slack"
    ],
    "onCapabilities": [
      "hook"
    ]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "toolTasks": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "Render compact Slack task rows for sub-agent tool-call progress. Defaults to false."
          }
        }
      }
    },
    "additionalProperties": false
  }
}
