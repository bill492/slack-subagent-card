{
  "name": "@unblocklabs/slack-subagent-card",
  "version": "1.2.14",
  "description": "OpenClaw plugin: Slack Block Kit status cards for sub-agent work in Slack threads.",
  "type": "module",
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "plugin:ci": "plugin-inspector ci --no-openclaw --runtime --mock-sdk --allow-execute && node ./scripts/verify-inspector-report.mjs",
    "pack:smoke": "node ./scripts/packed-install-smoke.mjs",
    "preflight": "node ./scripts/preflight.mjs",
    "release": "node ./scripts/release.mjs",
    "metadata:check": "node ./scripts/release.mjs --metadata-check",
    "release:test": "node --test ./scripts/*.test.mjs",
    "test": "npm run build && node --test task-card.test.mjs index.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@slack/web-api": "^7.15.0"
  },
  "devDependencies": {
    "@openclaw/plugin-inspector": "0.3.18",
    "@types/node": "^22.0.0",
    "openclaw": "2026.7.2-beta.3",
    "semver": "7.8.5",
    "typescript": "^5.9.0"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "@unblocklabs/slack-subagent-card",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.7.2-beta.3"
    },
    "release": {
      "publishToClawHub": false,
      "publishToNpm": true
    },
    "compat": {
      "pluginApi": ">=2026.7.2-beta.3",
      "minGatewayVersion": ">=2026.7.2-beta.3"
    },
    "build": {
      "openclawVersion": "2026.7.2-beta.3",
      "pluginSdkVersion": "2026.7.2-beta.3"
    }
  },
  "keywords": [
    "openclaw",
    "plugin",
    "slack",
    "subagent",
    "block-kit",
    "notifications"
  ],
  "license": "MIT",
  "author": "Unblock Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bill492/slack-subagent-card.git"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.2-beta.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "files": [
    "index.ts",
    "plugin-handlers.ts",
    "task-card.ts",
    "task-text-sanitizer.ts",
    "dist/",
    "openclaw.plugin.json"
  ]
}
